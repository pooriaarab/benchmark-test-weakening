{
  "name": "benchmark-test-weakening",
  "version": "0.1.0",
  "description": "Coding-agent benchmark that detects test weakening with hidden assertions, held-out cases, and deterministic mutation testing.",
  "keywords": [
    "ai-benchmark",
    "coding-agent",
    "llm-evaluation",
    "model-evaluation",
    "software-testing",
    "mutation-testing",
    "test-weakening",
    "code-repair",
    "agent-safety",
    "openrouter",
    "openai",
    "mcp",
    "typescript"
  ],
  "homepage": "https://aibenchmarkindex.com/benchmarks/benchmark-test-weakening",
  "bugs": "https://github.com/pooriaarab/benchmark-test-weakening/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/benchmark-test-weakening.git"
  },
  "license": "MIT",
  "author": "Pooria Arab",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    }
  },
  "bin": {
    "benchmark-test-weakening": "./dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "docs",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "server.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "oxlint src scripts",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "provenance": "node scripts/provenance.mjs",
    "generate:tasks": "node scripts/gen-tasks.mjs",
    "e2e": "node scripts/e2e.mjs",
    "ci:local": "npm run lint && npm run typecheck && npm run build && npm run e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.1",
    "acorn": "^8.19.0",
    "benchmark-core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.23.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
